spring.application.name=api-sentinel-backend
spring.datasource.url=jdbc:postgresql://localhost:5432/apisentinel
spring.datasource.username=postgres
spring.datasource.password=CHANGE_ME
spring.datasource.driver-class-name=org.postgresql.Driver

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect
server.port=8081

gemini.api.key=${GEMINI_API_KEY}
gemini.api.url=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash:generateContent
gemini.api.url.fallback=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash-lite:generateContent